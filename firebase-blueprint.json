{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authentication and role access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "specialist", "customer", "student"] },
        "avatar": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "Academy course offering",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "instructor": { "type": "string" },
        "thumbnail": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "Service": {
      "title": "Service",
      "description": "Agency IT and creative service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "badge": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "DigitalProduct": {
      "title": "DigitalProduct",
      "description": "Downloadable digital product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "downloadUrl": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Course or platform payment order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "amount", "status"]
    },
    "MarketplaceOrder": {
      "title": "MarketplaceOrder",
      "description": "Freelance marketplace gig or custom job order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "amount", "status"]
    },
    "MarketplaceGig": {
      "title": "MarketplaceGig",
      "description": "Specialist service gig listed on the marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "MarketplaceJob": {
      "title": "MarketplaceJob",
      "description": "Client job post for custom projects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "budget": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "budget"]
    },
    "MarketplaceProposal": {
      "title": "MarketplaceProposal",
      "description": "Freelancer bid on job posts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "freelancerId": { "type": "string" },
        "bidAmount": { "type": "number" },
        "coverLetter": { "type": "string" }
      },
      "required": ["id", "jobId", "freelancerId", "bidAmount"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Media portfolio image or project showcase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Student or client feedback and review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["id", "name", "text", "rating"]
    },
    "WrittenContent": {
      "title": "WrittenContent",
      "description": "Blog posts, articles, and public notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "published": { "type": "boolean" }
      },
      "required": ["id", "title", "content"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" }
      },
      "required": ["id"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or user notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "recipientId": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "AdminSpeedRecord": {
      "title": "AdminSpeedRecord",
      "description": "Staff and administrator response metrics and execution records",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string" },
        "badgeLevel": { "type": "string" },
        "badgeTitle": { "type": "string" },
        "speedScore": { "type": "number" },
        "avgResponseTime": { "type": "string" },
        "actionsTakenCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["adminEmail", "speedScore"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student course enrollment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "status": { "type": "string" },
        "enrolledAt": { "type": "string" }
      },
      "required": ["id", "userId", "courseId"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Peer-to-peer or admin message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "text"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Customer inquiry message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "message"]
    },
    "CompanyBill": {
      "title": "CompanyBill",
      "description": "Corporate invoices and bills",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "billNumber": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "clientName": { "type": "string" }
      },
      "required": ["id", "amount", "status"]
    },
    "Payout": {
      "title": "Payout",
      "description": "Teacher and freelancer payout request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Courses offered by the academy"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Agency services"
    },
    "/digitalProducts/{productId}": {
      "schema": "DigitalProduct",
      "description": "Digital products catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Platform orders"
    },
    "/marketplaceOrders/{orderId}": {
      "schema": "MarketplaceOrder",
      "description": "Marketplace project orders"
    },
    "/gigs/{gigId}": {
      "schema": "MarketplaceGig",
      "description": "Specialist service gigs"
    },
    "/jobs/{jobId}": {
      "schema": "MarketplaceJob",
      "description": "Customer project jobs"
    },
    "/proposals/{proposalId}": {
      "schema": "MarketplaceProposal",
      "description": "Freelancer proposals on jobs"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Portfolio media"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Client reviews"
    },
    "/writtenContent/{contentId}": {
      "schema": "WrittenContent",
      "description": "Articles, blogs, and posts"
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "System site configurations"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User and system notifications"
    },
    "/admin_speed_records/{recordId}": {
      "schema": "AdminSpeedRecord",
      "description": "Admin performance and execution speed records"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Student course enrollments"
    },
    "/directMessages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Chat messages between users"
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Support and contact inquiries"
    },
    "/companyBills/{billId}": {
      "schema": "CompanyBill",
      "description": "Invoicing and billing documents"
    },
    "/payouts/{payoutId}": {
      "schema": "Payout",
      "description": "Instructor and freelancer payout requests"
    }
  }
}
