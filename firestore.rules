rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'mdskazi2016@gmail.com' ||
         request.auth.token.email == 'mdskazisohag@gmail.com' ||
         request.auth.token.email == 'admin@ptenit.com' ||
         request.auth.token.role == 'admin');
    }

    // 1. Users Collection
    // Allows full user management, profile creation, and profile updates for platform users
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Notifications Collection
    // Allows sending and updating notifications (read/unread status) across users and admins
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 3. Admin Speed Records Collection
    // Records staff and administrator operational metrics and response speeds
    match /admin_speed_records/{recordId} {
      allow read, write: if true;
    }

    // 4. Public Catalog & Content Collections
    match /courses/{courseId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /digitalProducts/{productId} {
      allow read, write: if true;
    }

    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    match /writtenContent/{contentId} {
      allow read, write: if true;
    }

    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // 5. Marketplace (Gigs, Jobs, Proposals)
    match /gigs/{gigId} {
      allow read, write: if true;
    }

    match /jobs/{jobId} {
      allow read, write: if true;
    }

    match /proposals/{proposalId} {
      allow read, write: if true;
    }

    // 6. Orders, Enrollments & Financials
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /marketplaceOrders/{orderId} {
      allow read, write: if true;
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    match /companyBills/{billId} {
      allow read, write: if true;
    }

    match /payouts/{payoutId} {
      allow read, write: if true;
    }

    // 7. Messaging, Contact & Inquiries
    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    match /directMessages/{messageId} {
      allow read, write: if true;
    }

    // 8. Academic / Student Assignments & Submissions
    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    match /liveSessions/{sessionId} {
      allow read, write: if true;
    }

    match /teacherNotices/{noticeId} {
      allow read, write: if true;
    }

    match /customerProjects/{projectId} {
      allow read, write: if true;
    }

    // 9. Operational & System Collections
    match /dashboard/{dashboardId} {
      allow read, write: if true;
    }

    match /support/{supportId} {
      allow read, write: if true;
    }

    match /ai_core/{aiId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /academy/{academyId} {
      allow read, write: if true;
    }

    match /marketplace/{marketId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /system/{systemId} {
      allow read, write: if true;
    }

    match /offers/{offerId} {
      allow read, write: if true;
    }

    // Fallback: Default allow read and write
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
